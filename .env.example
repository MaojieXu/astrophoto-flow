# pnpm translate reads these from the environment or from this file; this file is git-ignored.
# Route: the OpenCode inference gateway in front of the paid models. The key below is an
# OpenCode console key (oc_sk_...), not a DeepSeek platform key.
APF_TRANSLATION_API_KEY=
APF_TRANSLATION_BASE_URL=https://opencode.ai/inference/go/openai/v1
APF_TRANSLATION_MODEL=deepseek-v4.1-flash
APF_TRANSLATION_TIMEOUT_MS=300000
APF_TRANSLATION_MAX_RETRIES=3
